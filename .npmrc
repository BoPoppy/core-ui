verify-deps-before-run=false
auto-install-peers=true

# Route the @bopoppy scope to GitHub Packages.
@bopoppy:registry=https://npm.pkg.github.com
# Auth is NOT kept here: pnpm ignores env-var tokens in a repo .npmrc. Put the
# token in your user-level ~/.npmrc instead:
#   //npm.pkg.github.com/:_authToken=<GitHub PAT with write:packages>
# CI sets it automatically via actions/setup-node (see release.yml).
